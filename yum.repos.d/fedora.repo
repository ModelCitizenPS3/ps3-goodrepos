[fedora]
name=Fedora $releasever - $basearch
baseurl=http://mirror.math.princeton.edu/pub/fedora-archive/fedora/linux/releases/$releasever/Everything/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-$releasever-primary
exclude=fedora-release lapack lapack-devel blas blas-devel

[fedora-SRPMS]
name=Fedora $releasever SRPMS - $basearch
baseurl=http://mirror.math.princeton.edu/pub/fedora-archive/fedora/linux/releases/$releasever/Everything/source/SRPMS/
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-$releasever-primary
exclude=fedora-release lapack lapack-devel blas blas-devel

[fedora-debug]
name=Fedora $releasever debug - $basearch
baseurl=http://mirror.math.princeton.edu/pub/fedora-archive/fedora/linux/releases/$releasever/Everything/$basearch/debug/
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-$releasever-primary
exclude=fedora-release lapack lapack-devel blas blas-devel
